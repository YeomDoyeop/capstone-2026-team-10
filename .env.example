# 이 파일을 .env로 복사한 뒤 값을 입력합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RunPod에 배포한 ave-whisper-api 호출에 필요합니다.
WHISPER_RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
WHISPER_RUNPOD_TIMEOUT_SECONDS=

# 서버가 호출하는 LLM 공급자 키입니다.
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# VM 배포 구성입니다.
AVE_DOMAIN=
STT_FILES_DIR=
