# 이 파일을 .env로 복사한 뒤 값을 입력합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RunPod에 배포한 ave-whisper-api 호출에 필요합니다.
WHISPER_RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
WHISPER_RUNPOD_TIMEOUT_SECONDS=3600
TRANSCRIPTION_LEASE_SECONDS=60
TRANSCRIPTION_LEASE_SWEEP_SECONDS=15
# 완료된 Whisper 결과를 클라이언트 ACK 또는 만료까지 보관하는 시간(초)
TRANSCRIPTION_RESULT_TTL_SECONDS=900

# 서버가 호출하는 LLM 공급자 키입니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# VM 배포 구성입니다.
AVE_DOMAIN=
STT_FILES_DIR=/srv/ave-stt/files
STT_FILE_MAX_BYTES=1073741824
